---
import '../styles/global.css';
import { site, asset } from '../data/site';
import { getRelease } from '../data/release';

interface Props {
  title: string;
  description?: string;
  /** Keep this route out of search results. Set on error pages. */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;

// Derived from the current route rather than pinned to the homepage. It was the
// latter while this was a one-page site, which quietly made every future route
// claim to be `/`.
const canonical = new URL(Astro.url.pathname, site.url).href;

// Absolute, and deliberately not via `asset()`: that returns a root-relative
// path, which crawlers will not resolve. Every scraper wants a full origin here.
const ogImage = new URL('og.png', site.url).href;
const ogImageAlt =
  'Clowder: run a fleet of coding agents, never lose track of one. Beside the ' +
  'wordmark, the app showing a sidebar of seven named agents with status dots ' +
  'next to a terminal displaying a git diff.';

const release = await getRelease();

// Every field here already exists as a typed constant, so this is markup over
// data we hold rather than a second copy to keep in sync.
//
// `offers` is deliberately absent: schema.org treats a missing offer as unknown
// pricing, which is honest, whereas asserting price 0 is a claim about the
// product that would need retracting if Clowder is ever paid. `aggregateRating`
// is absent for the blunter reason that there are no ratings to report.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  description: site.description,
  url: site.url,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: `macOS ${site.minMacOS} (${site.minMacOSName}) or later, ${site.arch}`,
  softwareVersion: release.version,
  downloadUrl: release.dmgUrl,
  fileSize: `${release.dmgSizeMb} MB`,
  author: { '@type': 'Organization', name: site.copyrightHolder },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/*
      SVG first so browsers that understand it prefer it — it is the only one that
      stays crisp at every size. The .ico is the fallback for clients that never
      learned SVG favicons, and apple-touch-icon exists because iOS is one of them
      and will otherwise screenshot the page for the home-screen tile.
    */}
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="icon" sizes="48x48" href={asset('favicon.ico')} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('manifest.webmanifest')} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#080d0f" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.7rem 1.1rem;
        background: var(--accent);
        color: #04191a;
        font-weight: 600;
        border-radius: 0 0 8px 0;
      }
      .skip:focus {
        left: 0;
      }
    </style>
  </body>
</html>
