---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A real screenshot of Clowder.app.
 *
 * The captures already include the app's own window chrome (traffic lights,
 * title bar), so they are NOT wrapped in a CSS window frame — that would
 * double up. Only a shadow and rounded corners are added.
 *
 * Images are imported through Astro's asset pipeline, which emits hashed,
 * width-optimised files and handles the GitHub Pages base path automatically.
 */

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  priority?: boolean;
  widths?: number[];
}

const { src, alt, caption, priority = false, widths = [800, 1200, 1800, 2400] } = Astro.props;
---

<figure class="shot">
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes="(max-width: 1200px) 100vw, 1140px"
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 0;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-bright);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.5),
      0 50px 90px -40px rgba(0, 0, 0, 0.95),
      0 0 120px -60px var(--accent-glow);
  }

  figcaption {
    margin-top: 0.9rem;
    text-align: center;
    font-size: 0.78rem;
    color: var(--text-faint);
    text-wrap: balance;
  }
</style>
